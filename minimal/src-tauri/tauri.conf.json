{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEO Minimal",
  "version": "0.1.0",
  "identifier": "com.neominimal.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEO Minimal",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#f7f6f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A quiet place to write your next novel.",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
